{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    // Os testes importam `supabase/functions/**/protocol.ts` direto, e esses
    // módulos importam os irmãos com a extensão `.ts` porque é o que o Deno
    // exige. Sem esta linha, o `tsc` do aplicativo reprova o import de um
    // arquivo que ele só enxerga por causa dos testes. Nada em `src/` usa
    // extensão em import — a permissão existe para a fronteira, não para o app.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    // Supabase Edge Functions target Deno, not React Native: they use JSR
    // specifiers and the Deno global. They are type-checked by `deno check`,
    // not by the app's TypeScript project.
    "supabase/functions"
  ]
}
