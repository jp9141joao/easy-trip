{
  "expo": {
    "name": "Easy Trip",
    "slug": "easy-trip",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easytrip",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Easy Trip usa suas fotos para anexar imagens ao diário de viagem e aos seus documentos.",
        "NSCameraUsageDescription": "O Easy Trip usa a câmera para registrar fotos no diário de viagem.",
        "NSLocationWhenInUseUsageDescription": "O Easy Trip usa sua localização para mostrar o mapa e lugares próximos ao seu destino."
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#020617"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Easy Trip usa suas fotos para anexar imagens ao diário e aos documentos da viagem.",
          "cameraPermission": "O Easy Trip usa a câmera para registrar fotos no diário de viagem."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Easy Trip usa sua localização para mostrar o mapa do destino."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0EA5E9",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}