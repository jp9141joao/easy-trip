# =============================================================================
# Easy Trip 2.0 — environment (§17, §120)
#
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Only EXPO_PUBLIC_* variables are readable by the app; everything else in this
# file is a reminder of what belongs on the SERVER, configured with
# `supabase secrets set ...` and never bundled into the mobile app.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT (safe to ship in the bundle)
# -----------------------------------------------------------------------------
# Leave both blank to run in demonstration mode: the app stays fully functional
# and persistent, but stores everything on the device only.
EXPO_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA do projeto. A autorização real é feita pela Row Level Security
# (supabase/migrations/0002_rls.sql), então uma chave pública vazada, sozinha,
# não dá acesso aos dados de ninguém — é por isso que ela pode ir no bundle.
#
# Aceita os dois formatos, conforme a idade do projeto Supabase:
#   • legado    → JWT começando com `eyJ...`   (rotulado "anon public")
#   • atual     → `sb_publishable_...`         (rotulado "Publishable key")
# O `supabase-js` recebe os dois na mesma posição; nada muda no código.
#
# ⚠️ NUNCA cole aqui a chave `service_role` nem a `sb_secret_...`. As duas
# IGNORAM a RLS por completo. O aplicativo funcionaria normalmente — e o banco
# inteiro ficaria exposto a qualquer pessoa com o APK. As chaves se parecem;
# confira o rótulo no dashboard antes de copiar.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the BFF (Supabase Edge Functions).
# Example: https://<project-ref>.functions.supabase.co
# Leave blank and BOTH the AI assistant and the admin "Preencher com IA" run in
# clearly-labelled unavailable mode — neither ever fabricates a result.
EXPO_PUBLIC_BFF_URL=

# -----------------------------------------------------------------------------
# NOT an environment variable: EASYTRIP_CONTACT_WHATSAPP
# -----------------------------------------------------------------------------
# O WhatsApp comercial mora em `src/constants/contact.ts`, ao lado do convite da
# comunidade em `src/constants/community.ts` — mesmo padrão, arquivos separados
# porque são canais diferentes.
#
# Não é segredo (está em qualquer rodapé comercial) e não muda por ambiente, o
# que o torna configuração de código e não de ambiente. Enquanto estiver vazio,
# o botão "Falar sobre este hotel/restaurante" simplesmente não aparece.

# =============================================================================
# SERVER ONLY — these must NEVER appear in the mobile bundle.
# Set them with: supabase secrets set NAME=value
#
#   GEMINI_API_KEY=...                       # IA nas Edge Functions
#   TRIP_DAILY_BRIEFING_CRON_SECRET=...      # segredo aleatório só do cron
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY NÃO precisam ser
# definidas: a plataforma as injeta automaticamente nas Edge Functions. O
# prefixo `SUPABASE_` é reservado e `secrets set` recusa nomes que o usem.
#
# Weather (Open-Meteo) and currency (Frankfurter) need no key at all, which is
# why they run directly from the app and are genuinely real, not simulated.
# =============================================================================
